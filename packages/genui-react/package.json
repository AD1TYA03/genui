{
  "name": "genui-react",
  "version": "0.2.0",
  "description": "React components for genui: drop-in generative UI chat and renderer for genui-py backends (AG-UI streaming, OpenUI Lang).",
  "license": "MIT",
  "author": "Aditya Kumar Singh",
  "homepage": "https://github.com/AD1TYA03/genui/tree/main/packages/genui-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AD1TYA03/genui.git",
    "directory": "packages/genui-react"
  },
  "bugs": {
    "url": "https://github.com/AD1TYA03/genui/issues"
  },
  "keywords": [
    "genui",
    "generative-ui",
    "react",
    "chat",
    "llm",
    "ai",
    "agent",
    "ag-ui",
    "openui",
    "openui-lang",
    "streaming",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/devtools.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@openuidev/react-headless": "~0.18.1",
    "@openuidev/react-lang": "~1.0.2",
    "@openuidev/react-ui": "~0.18.1",
    "zod": "^3.25.0 || ^4.0.0",
    "zustand": "^4.5.5"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
