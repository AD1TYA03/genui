{
  "root": "Form",
  "components": {
    "Form": {
      "signature": "Form(name: string, fields: (Select | Toggle)[], submit?: Button, anything?: any)",
      "description": "A form"
    },
    "Select": {
      "signature": "Select(name: string, items: SelectItem[], placeholder?: string, rules?: {required?: boolean, min?: number}, value?: $binding<string>)",
      "description": "A dropdown"
    },
    "SelectItem": {
      "signature": "SelectItem(value: string, label: string)",
      "description": "One option"
    },
    "Toggle": {
      "signature": "Toggle(label: string, on?: $binding<boolean>, tags?: $binding<string[]>)",
      "description": "An on/off switch"
    },
    "Button": {
      "signature": "Button(label: string, action?: ActionExpression, variant?: \"primary\" | \"secondary\", meta?: Record<string, number>, kind?: \"submit\", count?: 3)",
      "description": "A clickable button"
    }
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "Form": {
        "$ref": "#/$defs/Form"
      },
      "Select": {
        "$ref": "#/$defs/Select"
      },
      "SelectItem": {
        "$ref": "#/$defs/SelectItem"
      },
      "Toggle": {
        "$ref": "#/$defs/Toggle"
      },
      "Button": {
        "$ref": "#/$defs/Button"
      }
    },
    "required": [
      "Form",
      "Select",
      "SelectItem",
      "Toggle",
      "Button"
    ],
    "additionalProperties": false,
    "$defs": {
      "Form": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Select"
                },
                {
                  "$ref": "#/$defs/Toggle"
                }
              ]
            }
          },
          "submit": {
            "$ref": "#/$defs/Button"
          },
          "anything": {}
        },
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false,
        "description": "A form"
      },
      "Select": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SelectItem"
            }
          },
          "placeholder": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "items",
          "placeholder"
        ],
        "additionalProperties": false,
        "description": "A dropdown"
      },
      "SelectItem": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "description": "One option"
      },
      "Toggle": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "on": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "An on/off switch"
      },
      "Button": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "action": {
            "$ref": "#/$defs/ActionExpression"
          },
          "variant": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "kind": {
            "type": "string",
            "const": "submit"
          },
          "count": {
            "type": "number",
            "const": 3
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "A clickable button"
      },
      "ActionExpression": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "open_url"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "continue_conversation"
              },
              "context": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "id": "bindings"
}
