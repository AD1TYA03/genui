root = Stack([header, form])
header = InlineHeader("Book a Dental Cleaning", "Choose your preferred clinic, date, and time. We'll confirm by email.")
form = Form("dental-cleaning", btns, [locField, dateField, timeField, dentistField, newPatientField, insuranceField, notesField])
locField = FormControl("Clinic location", locSelect, "Pick the clinic closest to you")
locSelect = Select("location", locItems, "Select a clinic", { required: true })
locItems = [SelectItem("downtown", "Downtown Dental, 120 Main St"), SelectItem("riverside", "Riverside Dental, 45 River Rd"), SelectItem("westside", "Westside Smiles, 880 Oak Ave")]
dateField = FormControl("Preferred date", dateInput, "Weekdays and Saturdays only")
dateInput = DatePicker("date", "single", { required: true })
timeField = FormControl("Time slot", timeChips, "Slots are 60 minutes")
timeChips = Chips("time", "single", [t1, t2, t3, t4], { required: true })
t1 = ChipItem("8:00", "8:00 AM")
t2 = ChipItem("10:00", "10:00 AM")
t3 = ChipItem("13:00", "1:00 PM")
t4 = ChipItem("15:30", "3:30 PM")
dentistField = FormControl("Dentist preference", dentistRadio)
dentistRadio = RadioGroup("dentist", [d1, d2, d3], "any", { required: true })
d1 = RadioItem("Any available dentist", "Get the earliest open slot", "any")
d2 = RadioItem("Dr. Patel", "General and preventive care", "patel")
d3 = RadioItem("Dr. Chen", "Gentle care with a hygiene focus", "chen")
newPatientField = FormControl("Are you a new patient?", newPatientRadio)
newPatientRadio = RadioGroup("newPatient", [np1, np2], "no", { required: true })
np1 = RadioItem("Yes", "This is my first visit to this clinic", "yes")
np2 = RadioItem("No", "I've been seen here before", "no")
insuranceField = FormControl("Insurance provider", insuranceSelect, "Choose self-pay if you don't have insurance")
insuranceSelect = Select("insurance", insItems, "Select a provider", { required: true })
insItems = [SelectItem("delta", "Delta Dental"), SelectItem("cigna", "Cigna"), SelectItem("aetna", "Aetna"), SelectItem("metlife", "MetLife"), SelectItem("selfpay", "No insurance / self-pay")]
notesField = FormControl("Notes", notesArea, "Optional: allergies, concerns, or accessibility needs")
notesArea = TextArea("notes", "Anything we should know before your visit?", 4)
btns = Buttons([submitBtn, cancelBtn])
submitBtn = Button("Request appointment", @ToAssistant("Submit my dental cleaning appointment request"), "primary")
cancelBtn = Button("Cancel", @ToAssistant("Cancel the dental cleaning request"), "secondary")
