root = Card([heading, timeInfo, ingredientsHeader, ingredientsTable, stepsHeader, stepsBlock, nutritionHeader, nutritionList], "card", "column", "l")
heading = CardHeader("Thai Green Chicken Curry", "Weeknight recipe · Serves 4 · Easy")
timeInfo = EntityList([timeRow1, timeRow2, timeRow3, timeRow4])
timeRow1 = {left: "Prep time", right: "15 min"}
timeRow2 = {left: "Cook time", right: "25 min"}
timeRow3 = {left: "Total time", right: "40 min"}
timeRow4 = {left: "Difficulty", right: "Easy"}
ingredientsHeader = InlineHeader("Ingredients", "Quantities for 4 and 8 servings")
ingredientsTable = Table([colIng, col4, col8])
colIng = Col("Ingredient", ingNames)
col4 = Col("4 servings", qty4)
col8 = Col("8 servings", qty8)
ingNames = ["Boneless chicken thighs, sliced", "Green curry paste", "Full-fat coconut milk", "Thai or Japanese eggplant, cut in chunks", "Red bell pepper, sliced", "Green beans, trimmed", "Fish sauce", "Palm or brown sugar", "Kaffir lime leaves", "Thai basil leaves", "Vegetable oil", "Lime", "Jasmine rice (dry)"]
qty4 = ["600 g", "3 tbsp", "800 ml (2 cans)", "2 medium", "1", "150 g", "2 tbsp", "1 tbsp", "4", "1 handful (about 20 g)", "1 tbsp", "1", "300 g"]
qty8 = ["1.2 kg", "6 tbsp", "1.6 L (4 cans)", "4", "2", "300 g", "4 tbsp", "2 tbsp", "8", "2 handfuls (about 40 g)", "2 tbsp", "2", "600 g"]
stepsHeader = InlineHeader("Instructions", "About 40 minutes start to finish")
stepsBlock = Steps([s1, s2, s3, s4, s5, s6, s7, s8])
s1 = StepsItem("Cook the rice", "Rinse the jasmine rice and cook it according to the package directions so it is ready when the curry is.")
s2 = StepsItem("Bloom the paste", "Heat the oil in a wide pan or wok over medium-high. Add the green curry paste and fry 1–2 minutes, until fragrant and the oil turns bright green.")
s3 = StepsItem("Sear the chicken", "Add the chicken and stir-fry 3–4 minutes, until the outside is no longer pink.")
s4 = StepsItem("Build the base", "Pour in about two-thirds of the coconut milk and simmer 3 minutes, until the oil starts to separate from the cream.")
s5 = StepsItem("Simmer the curry", "Add the remaining coconut milk, lime leaves, fish sauce, and sugar. Add the eggplant and simmer 8 minutes, until soft.")
s6 = StepsItem("Add the vegetables", "Stir in the red pepper and green beans and simmer 3–4 minutes, until tender-crisp.")
s7 = StepsItem("Finish", "Off the heat, stir in the Thai basil and the juice of 1 lime. Taste and adjust with more fish sauce (salt), sugar (sweet), or lime (sour).")
s8 = StepsItem("Serve", "Spoon the curry over the rice and serve hot.")
nutritionHeader = InlineHeader("Nutrition per serving", "Estimated, curry only. Add about 270 kcal for the rice.")
nutritionList = EntityList([n1, n2, n3, n4, n5, n6])
n1 = {left: "Calories", right: "760 kcal"}
n2 = {left: "Protein", right: "32 g"}
n3 = {left: "Carbohydrates", right: "22 g"}
n4 = {left: "Fat", right: "55 g"}
