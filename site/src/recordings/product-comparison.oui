root = Stack([title, note, table, recCard], "column", "m")
title = TextContent("Noise-Cancelling Headphones Compared", "large-heavy")
note = TextContent("Specs are manufacturer-listed US prices and claims. Prices and promotions change, so check current pricing before you buy.", "small")
table = Table([colFeature, colSony, colBose, colApple])
colFeature = Col("Feature", ["List price (US)", "Battery life (ANC on)", "Weight", "Noise cancelling", "Codecs", "Multipoint"])
colSony = Col("Sony WH-1000XM5", ["$399.99", "Up to 30 hours", "250 g", "Excellent, adaptive", "SBC, AAC, LDAC", "Yes, 2 devices"])
colBose = Col("Bose QuietComfort Ultra", ["$429", "Up to 24 hours", "250 g", "Excellent, spatial audio", "SBC, AAC", "Yes, 2 devices"])
colApple = Col("Apple AirPods Max", ["$549", "Up to 20 hours", "385 g", "Excellent, adaptive", "AAC", "Limited to Apple devices"])
recHeader = InlineHeader("Best for Frequent Flyers", "Our pick: Sony WH-1000XM5")
rec = MarkDownRenderer("**Pick the Sony WH-1000XM5.** It has the longest battery of the three, weighs about 250 g, and offers strong noise cancelling with multipoint so you can switch between a laptop and a phone. LDAC support helps on Android. The Bose QuietComfort Ultra is a close second, especially if you prefer its fit. The AirPods Max only make sense if you are all-in on Apple, since they are the heaviest and have the shortest battery life.")
recCard = Card([recHeader, rec])
