root = Stack([header, urgent, triage, stepsHeader, urgentSteps])
header = InlineHeader("Support Ticket Triage", "5 tickets, sorted by urgency")
urgent = Callout("error", "Act now: Acme Corp checkout outage", "Enterprise customer, checkout returning 502 since this morning. Start incident response before working the rest of the queue.")
triage = Table([colTicket, colCustomer, colPriority, colCategory, colOwner, colNext])
colTicket = Col("Ticket", ["Checkout fails with 502", "Export invoices", "SSO login loops to sign-in", "Dark mode in mobile app", "Charged twice this month"])
colCustomer = Col("Customer", ["Acme Corp (Enterprise)", "Free user", "Globex (Business)", "Not specified", "Pro user"])
colPriority = Col("Priority", [prioP1, prioP4, prioP2, prioP4, prioP2])
prioP1 = Tag("P1 Critical", null, "sm", "danger")
prioP2 = Tag("P2 High", null, "sm", "warning")
prioP4 = Tag("P4 Low", null, "sm", "neutral")
colCategory = Col("Category", ["Outage / Bug", "How-to / Billing", "Bug / Authentication", "Feature request", "Billing error"])
colOwner = Col("Suggested owner", ["Payments on-call", "Tier 1 Support", "Identity team", "Mobile product", "Billing and Finance Ops"])
colNext = Col("Next steps", ["Check 502 logs and recent deploys, open incident, update Acme", "Send invoice export help article, close once confirmed", "Reproduce the loop, pull IdP config and timestamps from Globex", "Log on feature board, link duplicates, reply with thanks", "Verify duplicate in payment processor, refund if confirmed, reply to user"])
stepsHeader = InlineHeader("Acme Corp: first actions", "Do these before the rest of the queue")
urgentSteps = Steps([s1, s2, s3])
s1 = StepsItem("Confirm scope", "Check the checkout service 502 rate and error logs since this morning. Determine whether it affects all regions or only Acme.")
s2 = StepsItem("Check recent changes", "Review deploys, config changes, and payment provider status from the last 12 hours.")
s3 = StepsItem("Engage and communicate", "Page the payments on-call, open an incident, and send Acme an update with an ETA.")
