k4icon = Icon("target", "sales")
k4bottom = MetricIndicatorInline("4.6%", "vs 4.2% in Sep", {direction: "up", value: 0.4})
mrrCard = Card([mrrHeader, mrrChart])
mrrHeader = CardHeader("MRR trend", "Monthly recurring revenue, $K")
mrrChart = LineChart(months, [Series("MRR ($K)", mrrVals)], "natural", "Month", "MRR ($K)", 280)
months = ["May", "Jun", "Jul", "Aug", "Sep", "Oct"]
mrrVals = [48.2, 51.9, 55.3, 58.7, 61.4, 66.1]
row2 = Stack([channelCard, planCard], "row", "m", "stretch", "start", true)
channelCard = Card([channelHeader, channelChart])
channelHeader = CardHeader("Signups by channel", "New signups per month, stacked by source")
channelChart = BarChart(months, [sOrganic, sPaid, sReferral, sPartner], "stacked", "Month", "Signups", 280)
sOrganic = Series("Organic", [410, 445, 470, 462, 498, 531])
sPaid = Series("Paid", [220, 240, 255, 231, 268, 290])
sReferral = Series("Referral", [130, 138, 151, 147, 160, 172])
sPartner = Series("Partner", [60, 66, 71, 79, 84, 91])
planCard = Card([planHeader, planChart])
planHeader = CardHeader("Plan mix", "Accounts by current plan")
planChart = PieChart(planLabels, planVals, "donut")
planLabels = ["Free", "Starter", "Pro", "Enterprise"]
planVals = [2140, 1480, 890, 302]
