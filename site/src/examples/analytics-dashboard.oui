root = Stack([title, kpiBlock, mrrCard, row2], "column", "l")
title = TextContent("SaaS Dashboard: May to Oct 2026", "large-heavy")
kpiBlock = OverviewCardBlock([k1, k2, k3, k4], "grid")
k1 = OverviewCardItem("mrr", k1top, k1bottom)
k1top = IconText(k1icon, "neutral", "m", "MRR", "Monthly recurring revenue", false, "horizontal")
k1icon = Icon("circle-dollar-sign", "finance")
k1bottom = MetricIndicatorInline("$66.1K", "vs $61.4K in Sep", {direction: "up", value: 7.7})
k2 = OverviewCardItem("active-users", k2top, k2bottom)
k2top = IconText(k2icon, "neutral", "m", "Active Users", "Used product in last 30 days", false, "horizontal")
k2icon = Icon("users", "people")
k2bottom = MetricIndicatorInline("4,812", "vs 4,590 in Sep", {direction: "up", value: 4.8})
k3 = OverviewCardItem("churn", k3top, k3bottom)
k3top = IconText(k3icon, "neutral", "m", "Churn", "Monthly logo churn", false, "horizontal")
k3icon = Icon("user-minus", "people")
k3bottom = MetricIndicatorInline("2.1%", "vs 2.4% in Sep (lower is better)", {direction: "down", value: 0.3})
k4 = OverviewCardItem("conversion", k4top, k4bottom)
