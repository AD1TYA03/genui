root = Stack([heading, note, hotelTable, bookingHeader, bookingForm])
heading = TextContent("Lisbon, 4 nights for 2 adults", "large-heavy")
note = Callout("info", "Sample rates", "These are illustrative late March 2027 prices, not live availability. Confirm the rate before you book.")
hotelTable = Table([colHotel, colArea, colRating, colNightly, colTotal])
colHotel = Col("Hotel", ["Hotel Baixa Chiado", "Solar Alfama Boutique", "Avenida Park Hotel"])
colArea = Col("Neighborhood", ["Chiado / Baixa", "Alfama", "Avenidas Novas"])
colRating = Col("Rating", [4.7, 4.5, 4.3], "number")
colNightly = Col("Nightly price", ["€185", "€162", "€138"])
colTotal = Col("4-night total", ["€740", "€648", "€552"])
bookingHeader = InlineHeader("Book your stay", "Pick a hotel, dates, guests and room type")
bookingForm = Form("booking", bookingButtons, [hotelField, checkinField, checkoutField, guestsField, roomField])
hotelField = FormControl("Hotel", hotelSelect)
hotelSelect = Select("hotel", hotelItems, "Choose a hotel", {required: true})
hotelItems = [SelectItem("baixa", "Hotel Baixa Chiado, €185/night"), SelectItem("alfama", "Solar Alfama Boutique, €162/night"), SelectItem("avenidas", "Avenida Park Hotel, €138/night")]
checkinField = FormControl("Check-in", checkinPicker, "For example, 26 March 2027")
checkinPicker = DatePicker("checkin", "single", {required: true})
checkoutField = FormControl("Check-out", checkoutPicker, "Four nights after check-in")
checkoutPicker = DatePicker("checkout", "single", {required: true})
guestsField = FormControl("Guests", guestsSelect)
guestsSelect = Select("guests", guestItems, "Select guests", {required: true})
guestItems = [SelectItem("1", "1 adult"), SelectItem("2", "2 adults"), SelectItem("3", "3 adults"), SelectItem("4", "4 adults")]
roomField = FormControl("Room type", roomGroup)
roomGroup = RadioGroup("roomType", roomItems, "standard", {required: true})
roomItems = [RadioItem("Standard double", "Queen bed, city-facing, 22 m²", "standard"), RadioItem("Superior double", "King bed, river view, 28 m²", "superior"), RadioItem("Family suite", "Two queen beds, sitting area, 40 m²", "suite")]
bookingButtons = Buttons([Button("Confirm booking", @ToAssistant("Confirm my 4-night Lisbon booking for 2 adults using the selected hotel, dates, and room type."), "primary"), Button("Cancel", @ToAssistant("Cancel the Lisbon booking form."), "secondary")])
